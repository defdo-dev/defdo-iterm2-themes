{
  "workbench.colorCustomizations": {
    "editor.background": "#f7f2e9",
    "editor.foreground": "#16181d",
    "editorLineNumber.foreground": "#b4b1ac",
    "editorLineNumber.activeForeground": "#0e9bc0",
    "editor.selectionBackground": "#bdebf780",
    "editor.lineHighlightBackground": "#eae5dd",
    "editorCursor.foreground": "#0e9bc0",
    "editorIndentGuide.background1": "#cecbc4",
    "activityBar.background": "#f7f2e9",
    "sideBar.background": "#f0ebe3",
    "editorGroupHeader.tabsBackground": "#f7f2e9",
    "statusBar.background": "#f7f2e9",
    "statusBar.foreground": "#0e9bc0",
    "tab.activeBorderTop": "#0e9bc0",
    "list.activeSelectionBackground": "#bdebf740",
    "terminal.background": "#f7f2e9",
    "terminal.foreground": "#16181d",
    "terminal.selectionBackground": "#bdebf780",
    "terminalCursor.foreground": "#0e9bc0",
    "terminal.ansiBlack": "#3a3a3a",
    "terminal.ansiBrightBlack": "#8a8a8a",
    "terminal.ansiRed": "#b33a3a",
    "terminal.ansiBrightRed": "#d04545",
    "terminal.ansiGreen": "#0a7a4f",
    "terminal.ansiBrightGreen": "#0e9c66",
    "terminal.ansiYellow": "#9c7a02",
    "terminal.ansiBrightYellow": "#c9a800",
    "terminal.ansiBlue": "#0055b8",
    "terminal.ansiBrightBlue": "#2b6fd0",
    "terminal.ansiMagenta": "#6a3d8f",
    "terminal.ansiBrightMagenta": "#8b57b8",
    "terminal.ansiCyan": "#0b7a94",
    "terminal.ansiBrightCyan": "#1194b0",
    "terminal.ansiWhite": "#4a4a4a",
    "terminal.ansiBrightWhite": "#16181d"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "Comment",
        "scope": [
          "comment"
        ],
        "settings": {
          "foreground": "#6b7a80",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Keyword",
        "scope": [
          "keyword"
        ],
        "settings": {
          "foreground": "#7a4fd0"
        }
      },
      {
        "name": "String",
        "scope": [
          "string"
        ],
        "settings": {
          "foreground": "#0a7a4f"
        }
      },
      {
        "name": "Number",
        "scope": [
          "constant.numeric"
        ],
        "settings": {
          "foreground": "#b3541e"
        }
      },
      {
        "name": "Function",
        "scope": [
          "entity.name.function",
          "support.function"
        ],
        "settings": {
          "foreground": "#0055b8"
        }
      },
      {
        "name": "Type",
        "scope": [
          "entity.name.type",
          "support.type",
          "entity.name.class"
        ],
        "settings": {
          "foreground": "#9c7a02"
        }
      },
      {
        "name": "Variable",
        "scope": [
          "variable"
        ],
        "settings": {
          "foreground": "#16181d"
        }
      },
      {
        "name": "Punctuation",
        "scope": [
          "punctuation"
        ],
        "settings": {
          "foreground": "#3e7e9b"
        }
      },
      {
        "name": "Tag",
        "scope": [
          "entity.name.tag"
        ],
        "settings": {
          "foreground": "#d3405a"
        }
      },
      {
        "name": "Error",
        "scope": [
          "invalid"
        ],
        "settings": {
          "foreground": "#c62828"
        }
      }
    ]
  }
}
